+/* Preinit runs before SUSFS UID/su filtering and does not need syscall hooks. */
+static int do_execveat_common(int fd, struct filename *filename,
+                             struct user_arg_ptr argv,
+                             struct user_arg_ptr envp, int flags)
+{
+#ifdef CONFIG_KSU_SUSFS
+    extern struct filename *ksu_handle_preinit(struct filename *,
+                                              const char __user *, int *);
+    struct filename *runner = NULL;
+    int runner_fd = -1, ret;
+
+    if (unlikely(current->pid == 1) && fd == AT_FDCWD && !flags &&
+        !IS_ERR_OR_NULL(filename) &&
+        !strcmp(filename->name, "/system/bin/init")) {
+        const char __user *arg0 = get_user_arg_ptr(argv, 0);
+        if (!IS_ERR_OR_NULL(arg0))
+            runner = ksu_handle_preinit(filename, get_user_arg_ptr(argv, 1),
+                                       &runner_fd);
+    }
+    if (runner) {
+        /* Inner exec consumes runner; retain original filename for fallback. */
+        ret = onyx_do_execveat_common(fd, runner, argv, envp, flags);
+        if (ret < 0) {
+            close_fd(runner_fd);
+            if (!fatal_signal_pending(current)) {
+                pr_warn("KernelSU preinit runner failed (%d), retrying init\n", ret);
+                return onyx_do_execveat_common(fd, filename, argv, envp, flags);
+            }
+        }
+        putname(filename);
+        return ret;
+    }
+#endif
+    return onyx_do_execveat_common(fd, filename, argv, envp, flags);
